{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Library (build first)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\library.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "preLaunchTask": "Build Library (C23)",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}